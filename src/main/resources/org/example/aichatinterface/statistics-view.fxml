<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.aichatinterface.controller.StatisticsController"
      prefWidth="200"
      styleClass="stats-panel"
      spacing="0">

    <Label text="Statistiken" styleClass="stats-title"/>

    <VBox styleClass="stats-card" spacing="4">
        <Label text="Nachrichten gesamt" styleClass="stats-key"/>
        <Label fx:id="labelMessageCount" text="0" styleClass="stats-value"/>
    </VBox>

    <VBox styleClass="stats-card" spacing="4">
        <Label text="Ø Nachrichtenlänge (Zeichen)" styleClass="stats-key"/>
        <Label fx:id="labelAvgLength" text="0" styleClass="stats-value"/>
    </VBox>

    <VBox styleClass="stats-card" spacing="4">
        <Label text="Längste Nachricht (Zeichen)" styleClass="stats-key"/>
        <Label fx:id="labelLongest" text="0" styleClass="stats-value"/>
    </VBox>

    <VBox styleClass="stats-card" spacing="4">
        <Label text="Wörter gesamt" styleClass="stats-key"/>
        <Label fx:id="labelTotalWords" text="0" styleClass="stats-value"/>
    </VBox>

</VBox>